generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================
// ✅ 1. جداول المستأجرين والمستخدمين الأساسية
// =============================================

model Tenant {
  id                    Int      @id @default(autoincrement())
  name                  String   @db.VarChar(100)
  arabic_name           String?  @db.VarChar(100)
  license_key           String   @unique @db.VarChar(64)
  db_name               String   @unique @db.VarChar(100)
  phone                 String?  @db.VarChar(20)
  email                 String?  @db.VarChar(100)
  address               String?  @db.Text
  tax_number            String?  @db.VarChar(50)
  commercial_register   String?  @db.VarChar(50)
  currency              String   @default("EGP") @db.VarChar(3)
  timezone              String   @default("Africa/Cairo") @db.VarChar(50)
  logo_path             String?  @db.VarChar(200)
  is_active             Boolean  @default(true)
  max_users             Int      @default(5)
  max_storage_mb        Int      @default(100)
  subscription_plan     String   @default("basic") @db.VarChar(20)
  subscription_expiry   DateTime?
  can_manage_products   Boolean  @default(true)
  can_manage_sales      Boolean  @default(true)
  can_manage_purchases  Boolean  @default(true)
  can_manage_inventory  Boolean  @default(true)
  can_manage_customers  Boolean  @default(true)
  can_manage_suppliers  Boolean  @default(true)
  can_manage_employees  Boolean  @default(true)
  can_manage_reports    Boolean  @default(true)
  can_manage_settings   Boolean  @default(false)
  can_manage_backup     Boolean  @default(false)
  can_export_data       Boolean  @default(false)
  can_import_data       Boolean  @default(false)
  can_manage_roles      Boolean  @default(false)
  can_view_audit_log    Boolean  @default(false)
  total_users           Int      @default(0)
  total_storage_used_mb Int      @default(0)
  last_activity         DateTime?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt
  last_login            DateTime?
  sync_id               String   @unique @default(cuid())
  is_deleted            Boolean  @default(false)
  sync_status           String   @default("pending")
  synced_at             DateTime?
  sale_invoice_items SaleInvoiceItem[]
  purchase_invoice_items PurchaseInvoiceItem[]

  // ✅ العلاقات
  users           User[]
  roles           Role[]
  permissions     Permission[]
  employees       Employee[]
  warehouses      Warehouse[]
  categories      Category[]
  products        Product[]
  product_batches ProductBatch[]
  suppliers       Supplier[]
  customers       Customer[]
  sale_invoices   SaleInvoice[]
  purchase_invoices PurchaseInvoice[]
  inventory_movements InventoryMovement[]
  treasury_transactions TreasuryTransaction[]
  settings        Setting[]
  discount_tiers  DiscountTier[]
  profit_tiers               ProfitTier[]
  product_discount_tiers ProductDiscountTier[]
  customer_discount_policies CustomerDiscountPolicy[]
  customer_transactions CustomerTransaction[]
  customer_bonuses CustomerBonus[]
  companies       Company[]
  company_payments CompanyPayment[]
  company_purchase_histories CompanyPurchaseHistory[]
  company_products CompanyProduct[]
  purchase_requests PurchaseRequest[]
  purchase_request_items PurchaseRequestItem[]
  transaction_types TransactionType[]
  activity_logs   ActivityLog[]
  sales_returns   SalesReturn[]
  sales_return_items SalesReturnItem[]
  purchase_returns PurchaseReturn[]
  purchase_return_items PurchaseReturnItem[]
  // sync_queues, data_sync_queues, sync_conflicts تم إزالتها لأنها غير مرتبطة مباشرة بـ Tenant
  @@map("tenants")
}

model User {
  id                   Int      @id @default(autoincrement())
  username             String   @unique @db.VarChar(50)
  email                String   @unique @db.VarChar(100)
  password_hash        String   @db.VarChar(200)
  full_name            String   @db.VarChar(100)
  is_active            Boolean  @default(true)
  is_admin             Boolean  @default(false)
  is_system_admin_flag Boolean  @default(false)
  created_at           DateTime @default(now())
  last_login           DateTime?
  employee_id          Int?     @unique // ✅ تم إضافة unique لعلاقة واحد لواحد
  role_id              Int?
  tenant_id            Int?
  sync_id              String  @unique @default(cuid())
  is_deleted           Boolean @default(false)
  sync_status          String  @default("pending")
  synced_at            DateTime?
  purchase_requests PurchaseRequest[]
  customer_transactions CustomerTransaction[]
  // ✅ العلاقات (تم إزالة أسماء العلاقات غير الضرورية لتجنب أخطاء الجانب المقابل)
  tenant           Tenant?        @relation(fields: [tenant_id], references: [id])
  role             Role?          @relation(fields: [role_id], references: [id])
  employee         Employee?      @relation(fields: [employee_id], references: [id])
  permissions      UserPermission[]
  activities       ActivityLog[]
  treasury_transactions TreasuryTransaction[]
  created_products Product[]      @relation("CreatedProducts")
  company_payments CompanyPayment[]
  company_purchases CompanyPurchaseHistory[]
  sale_invoices    SaleInvoice[] @relation("SaleInvoiceUser")
  approved_sales   SaleInvoice[] @relation("SaleInvoiceApprover")
  cancelled_sales  SaleInvoice[] @relation("SaleInvoiceCanceller")


  received_purchases PurchaseInvoice[] @relation("PurchaseInvoiceReceiver")
  purchase_invoices    PurchaseInvoice[] @relation("PurchaseInvoiceUser")
  approved_purchases   PurchaseInvoice[] @relation("PurchaseInvoiceApprover")
  cancelled_purchases  PurchaseInvoice[] @relation("PurchaseInvoiceCanceller")
  authorized_purchases PurchaseInvoice[] @relation("PurchaseInvoiceAuthorizer")

  sales_returns         SalesReturn[] @relation("SalesReturnUser")
  approved_sales_returns SalesReturn[] @relation("SalesReturnApprover")
  cancelled_sales_returns SalesReturn[] @relation("SalesReturnCanceller")

  purchase_returns PurchaseReturn[]
  inventory_movements InventoryMovement[] @relation("UserInventoryMovements")
  resolved_conflicts SyncConflict[]      @relation("ResolvedConflicts")
  approved_movements InventoryMovement[] @relation("ApproverMovements")
  cancelled_movements InventoryMovement[] @relation("CancellerMovements")
  @@map("users")
}

model Role {
  id          Int    @id @default(autoincrement())
  name        String @unique @db.VarChar(50)
  description String? @db.VarChar(200)
  tenant_id   Int
  sync_id     String @unique @default(cuid())
  is_deleted  Boolean @default(false)
  sync_status String @default("pending")
  synced_at   DateTime?

  // ✅ العلاقات
  tenant      Tenant             @relation(fields: [tenant_id], references: [id])
  users       User[]
  permissions RolePermission[]
  @@map("roles")
}

model Permission {
  id          Int    @id @default(autoincrement())
  name        String @unique @db.VarChar(50)
  description String? @db.VarChar(200)
  tenant_id   Int
  sync_id     String @unique @default(cuid())
  is_deleted  Boolean @default(false)
  sync_status String @default("pending")
  synced_at   DateTime?

  // ✅ العلاقات
  tenant      Tenant             @relation(fields: [tenant_id], references: [id])
  users       UserPermission[]
  roles       RolePermission[]
  @@map("permissions")
}

// =============================================
// ✅ جداول الربط (Many-to-Many)
// =============================================

model UserPermission {
  user_id       Int
  permission_id Int

  user       User       @relation(fields: [user_id], references: [id])
  permission Permission @relation(fields: [permission_id], references: [id])

  @@id([user_id, permission_id])
  @@map("user_permissions")
  
}

model RolePermission {
  role_id       Int
  permission_id Int

  role       Role       @relation(fields: [role_id], references: [id])
  permission Permission @relation(fields: [permission_id], references: [id])

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

// =============================================
// ✅ 2. جدول الموظفين
// =============================================

model Employee {
  id                    Int      @id @default(autoincrement())
  employee_id           String   @unique @db.VarChar(20)
  full_name             String   @db.VarChar(100)
  arabic_name           String?  @db.VarChar(100)
  position              String?  @db.VarChar(50)
  department            String?  @db.VarChar(50)
  phone                 String?  @db.VarChar(20)
  email                 String?  @db.VarChar(100)
  hire_date             DateTime?
  salary                Float?
  address               String?  @db.Text
  notes                 String?  @db.Text
  is_active             Boolean  @default(true)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt
  birth_date            DateTime?
  gender                String?  @db.VarChar(10)
  national_id           String?  @unique @db.VarChar(20)
  social_insurance_number String? @unique @db.VarChar(30)
  bank_account          String?  @db.VarChar(30)
  iban                  String?  @db.VarChar(34)
  tenant_id             Int
  emergency_contact     String?  @db.VarChar(100)
  emergency_phone       String?  @db.VarChar(20)
  contract_type         String?  @db.VarChar(20)
  contract_start_date   DateTime?
  contract_end_date     DateTime?
  vacation_balance      Float    @default(0)
  sick_leave_balance    Float    @default(0)
  performance_rating    Int      @default(3)
  supervisor_id         Int?
  company_id            Int?
  sync_id               String   @unique @default(cuid())
  is_deleted            Boolean  @default(false)
  sync_status           String   @default("pending")
  synced_at             DateTime?
  treasury_transactions_employee TreasuryTransaction[] @relation("EmployeeTreasury")

  // ✅ العلاقات (تم إزالة أسماء العلاقات غير الضرورية)
  tenant            Tenant          @relation(fields: [tenant_id], references: [id])
  company           Company?        @relation(fields: [company_id], references: [id])
  supervisor        Employee?       @relation("Supervisor", fields: [supervisor_id], references: [id])
  subordinates      Employee[]      @relation("Supervisor")
  user              User?
  responsible_products Product[]
  responsible_suppliers Supplier[]
  responsible_customers Customer[]
  responsible_sales_returns SalesReturn[]
  responsible_purchase_invoices PurchaseInvoice[]
  responsible_sale_invoices SaleInvoice[]
  @@map("employees")
}

// =============================================
// ✅ 3. جداول المخازن والفئات والمنتجات
// =============================================

model Warehouse {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(50)
  arabic_name String?  @db.VarChar(50)
  code        String   @unique @db.VarChar(20)
  address     String?  @db.Text
  phone       String?  @db.VarChar(20)
  manager     String?  @db.VarChar(100)
  is_active   Boolean  @default(true)
  is_default  Boolean  @default(false)
  notes       String?  @db.Text
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  company_id  Int?
  tenant_id   Int
  sync_id     String  @unique @default(cuid())
  is_deleted  Boolean @default(false)
  sync_status String  @default("pending")
  synced_at   DateTime?

  // ✅ العلاقات
  tenant          Tenant          @relation(fields: [tenant_id], references: [id])
  company         Company?        @relation(fields: [company_id], references: [id])
  products        Product[]       @relation("DefaultWarehouse")
  batches         ProductBatch[]
  sale_items      SaleInvoiceItem[]
  purchase_items  PurchaseInvoiceItem[]
  sales_return_items SalesReturnItem[]
  inventory_movements_from InventoryMovement[] @relation("FromWarehouse")
  inventory_movements_to InventoryMovement[] @relation("ToWarehouse")
  @@map("warehouses")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  arabic_name String?  @db.VarChar(50)
  parent_id   Int?
  description String?  @db.Text
  is_active   Boolean  @default(true)
  company_id  Int?
  tenant_id   Int
  sync_id     String  @unique @default(cuid())
  is_deleted  Boolean @default(false)
  sync_status String  @default("pending")
  synced_at   DateTime?

  // ✅ العلاقات
  tenant      Tenant    @relation(fields: [tenant_id], references: [id])
  company     Company?  @relation(fields: [company_id], references: [id])
  parent      Category? @relation("CategoryParent", fields: [parent_id], references: [id])
  subcategories Category[] @relation("CategoryParent")
  products    Product[]
  @@map("categories")
}

model Product {
  id                    Int      @id @default(autoincrement())
  product_id            String   @unique @db.VarChar(20)
  name                  String   @db.VarChar(100)
  arabic_name           String?  @db.VarChar(100)
  barcode               String?  @unique @db.VarChar(50)
  serial_number         String?  @unique @db.VarChar(50)
  image_path            String?  @db.VarChar(200)
  image_url             String?  @db.VarChar(500)
  storage_type          String   @default("local") @db.VarChar(20)
  description           String?  @db.Text
  category_id           Int?
  supplier_id           Int?
  track_batches         Boolean  @default(true)
  default_shelf_life    Int?
  quantity              Float    @default(0)
  min_quantity          Float    @default(0)
  max_quantity          Float    @default(0)
  reorder_level         Float    @default(0)
  tenant_id             Int
  purchase_price        Float    @default(0)
  sale_price_1          Float    @default(0)
  sale_price_2          Float    @default(0)
  sale_price_3          Float    @default(0)
  unit                  String?  @db.VarChar(20)
  is_active             Boolean  @default(true)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt
  weight                Float    @default(0)
  length                Float    @default(0)
  width                 Float    @default(0)
  height                Float    @default(0)
  tax_rate              Float    @default(0)
  tax_inclusive         Boolean  @default(false)
  avg_cost              Float    @default(0)
  last_price_update     DateTime?
  manufacturer          String?  @db.VarChar(100)
  model                 String?  @db.VarChar(50)
  location              String?  @db.VarChar(100)
  default_warehouse_id  Int?
  company_id            Int?
  responsible_employee_id Int?
  price_retail          Float    @default(0)
  price_wholesale       Float    @default(0)
  price_contract        Float    @default(0)
  use_tier_pricing      Boolean  @default(false)
  has_discount          Boolean  @default(false)
  discount_percent      Float    @default(0)
  discount_fixed        Float    @default(0)
  discount_type         String   @default("percentage") @db.VarChar(10)
  product_discount_tier_id Int?
  expected_profit_percent Float @default(0)
  expected_profit_amount Float @default(0)
  barcode_local         String?  @unique @db.VarChar(50)
  barcode_international String?  @unique @db.VarChar(50)
  thumbnail_path        String?  @db.VarChar(200)
  box                   String?  @db.VarChar(50)
  audience              String?  @db.VarChar(100)
  promoter              String?  @db.VarChar(100)
  packet                String?  @db.VarChar(50)
  sale_price_rep        Float    @default(0)
  sale_price_company    Float    @default(0)
  has_offer             Boolean  @default(false)
  offer_price           Float    @default(0)
  offer_start_date      DateTime?
  offer_end_date        DateTime?
  offer_description     String?  @db.VarChar(200)
  created_by            Int?
  price_public          Float    @default(0)
  sync_id               String   @unique @default(cuid())
  is_deleted            Boolean  @default(false)
  sync_status           String   @default("pending")
  synced_at             DateTime?
  sales_return_items SalesReturnItem[]
  purchase_return_items PurchaseReturnItem[]



  // ✅ العلاقات
  tenant                Tenant          @relation(fields: [tenant_id], references: [id])
  category              Category?       @relation(fields: [category_id], references: [id])
  supplier              Supplier?       @relation(fields: [supplier_id], references: [id])
  company               Company?        @relation(fields: [company_id], references: [id])
  responsible_employee  Employee?       @relation(fields: [responsible_employee_id], references: [id])
  default_warehouse     Warehouse?      @relation("DefaultWarehouse", fields: [default_warehouse_id], references: [id])
  product_discount_tier ProductDiscountTier? @relation(fields: [product_discount_tier_id], references: [id])
  creator               User?           @relation("CreatedProducts", fields: [created_by], references: [id])
  batches               ProductBatch[]
  sale_items            SaleInvoiceItem[]
  purchase_items        PurchaseInvoiceItem[]
  movements             InventoryMovement[]
  company_supplies      CompanyProduct[]
  sync_entries          SyncQueue[]
  @@map("products")
}

model ProductBatch {
  id                   Int      @id @default(autoincrement())
  product_id           Int
  batch_number         String   @db.VarChar(50)
  expiry_date          DateTime
  quantity             Float
  purchase_price       Float    @default(0)
  sale_price_1         Float    @default(0)
  sale_price_2         Float    @default(0)
  sale_price_3         Float    @default(0)
  supplier_id          Int?
  purchase_invoice_id  Int?
  is_active            Boolean  @default(true)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt
  tax_rate             Float    @default(0)
  avg_cost             Float    @default(0)
  notes                String?  @db.Text
  tenant_id            Int
  warehouse_id         Int?
  company_id           Int?
  sync_id              String   @unique @default(cuid())
  is_deleted           Boolean  @default(false)
  sync_status          String   @default("pending")
  synced_at            DateTime?

  // ✅ العلاقات (تم إزالة أسماء العلاقات غير الضرورية)
  product           Product           @relation(fields: [product_id], references: [id])
  supplier          Supplier?         @relation(fields: [supplier_id], references: [id])
  purchase_invoice  PurchaseInvoice?  @relation(fields: [purchase_invoice_id], references: [id])
  tenant            Tenant            @relation(fields: [tenant_id], references: [id])
  warehouse         Warehouse?        @relation(fields: [warehouse_id], references: [id])
  company           Company?          @relation(fields: [company_id], references: [id])
  @@map("product_batches")
}

model ProductDiscountTier {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(50)
  arabic_name   String?  @db.VarChar(50)
  min_quantity  Int      @default(0)
  max_quantity  Int      @default(0)
  tenant_id     Int
  discount_type String   @default("percentage") @db.VarChar(10)
  discount_value Float   @default(0)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  company_id    Int?
  sync_id       String   @unique @default(cuid())
  is_deleted    Boolean  @default(false)
  sync_status   String   @default("pending")
  synced_at     DateTime?

  // ✅ العلاقات
  tenant  Tenant    @relation(fields: [tenant_id], references: [id])
  company Company?  @relation(fields: [company_id], references: [id])
  products Product[]
  @@map("product_discount_tiers")
}

// =============================================
// ✅ 4. جداول الموردين والعملاء والشركات
// =============================================

model Supplier {
  id                     Int      @id @default(autoincrement())
  supplier_id            String   @unique @db.VarChar(20)
  name                   String   @db.VarChar(100)
  arabic_name            String?  @db.VarChar(100)
  contact_person         String?  @db.VarChar(100)
  phone                  String?  @db.VarChar(20)
  email                  String?  @db.VarChar(100)
  address                String?  @db.Text
  tax_number             String?  @db.VarChar(50)
  balance                Float    @default(0)
  notes                  String?  @db.Text
  is_active              Boolean  @default(true)
  created_at             DateTime @default(now())
  company_id             Int?
  responsible_employee_id Int?
  tenant_id              Int
  website                String?  @db.VarChar(200)
  fax                    String?  @db.VarChar(20)
  commercial_register    String?  @db.VarChar(50)
  tax_card               String?  @db.VarChar(50)
  bank_account           String?  @db.VarChar(50)
  iban                   String?  @db.VarChar(34)
  supplier_type          String   @default("local") @db.VarChar(20)
  rating                 Int      @default(3)
  total_purchases        Float    @default(0)
  purchase_count         Int      @default(0)
  last_purchase_date     DateTime?
  default_payment_terms  Int      @default(30)
  default_discount_percent Float @default(0)
  tier                   String?  @db.VarChar(50)
  is_vip                 Boolean  @default(false)
  dealing_type           String   @default("retail") @db.VarChar(20)
  discount_tier_id       Int?
  use_tier_pricing       Boolean  @default(false)
  sync_id                String   @unique @default(cuid())
  is_deleted             Boolean  @default(false)
  sync_status            String   @default("pending")
  synced_at              DateTime?
  best_purchase_requests PurchaseRequest[] @relation("BestSupplier")
  best_purchase_request_items PurchaseRequestItem[] @relation("BestSupplierItem")
  // ✅ العلاقات (تم إزالة أسماء العلاقات غير الضرورية)
  tenant              Tenant    @relation(fields: [tenant_id], references: [id])
  company             Company?  @relation(fields: [company_id], references: [id])
  responsible_employee Employee? @relation(fields: [responsible_employee_id], references: [id])
  discount_tier       DiscountTier? @relation(fields: [discount_tier_id], references: [id])
  products            Product[]
  product_batches     ProductBatch[]
  purchase_invoices   PurchaseInvoice[]
  returns             PurchaseReturn[]
  inventory_movements InventoryMovement[]
  treasury_transactions TreasuryTransaction[]
  @@map("suppliers")
}

// =============================================
// ✅ جدول شرائح الربح (ProfitTier)
// =============================================

model ProfitTier {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(50)
  arabic_name   String?  @db.VarChar(50)
  description   String?  @db.Text
  
  // نسبة الربح المضافة (نسبة مئوية)
  profit_percent Float   @default(0)
  
  // فترة السداد بالأيام (اختياري)
  days          Int      @default(0)
  
  // نوع التعامل (retail, wholesale, contract)
  dealing_type  String   @default("retail") @db.VarChar(20)
  
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  
  // ربط الشريحة بالمستأجر
  tenant_id     Int
  sync_id       String   @unique @default(cuid())
  is_deleted    Boolean  @default(false)
  sync_status   String   @default("pending")
  synced_at     DateTime?

  // ✅ العلاقات
  tenant        Tenant   @relation(fields: [tenant_id], references: [id])
  customers     Customer[] // العلاقة مع العملاء
  
  @@map("profit_tiers")
}

model Customer {
  id                         Int      @id @default(autoincrement())
  customer_id                String   @unique @db.VarChar(20)
  name                       String   @db.VarChar(100)
  arabic_name                String?  @db.VarChar(100)
  phone                      String?  @db.VarChar(20)
  email                      String?  @db.VarChar(100)
  address                    String?  @db.Text
  tax_number                 String?  @db.VarChar(50)
  notes                      String?  @db.Text
  is_active                  Boolean  @default(true)
  created_at                 DateTime @default(now())
  tenant_id                  Int
  balance                    Float    @default(0)
  credit_limit               Float    @default(0)
  company_id                 Int?
  responsible_employee_id    Int?
  customer_type              String   @default("individual") @db.VarChar(20)
  tier                       String?  @db.VarChar(50)
  is_vip                     Boolean  @default(false)
  is_new                     Boolean  @default(true)
  dealing_type               String   @default("retail") @db.VarChar(20)
  total_purchases            Float    @default(0)
  purchase_count             Int      @default(0)
  last_purchase_date         DateTime?
  discount_tier_id           Int?
  use_tier_pricing           Boolean  @default(false)
  profit_tier_id             Int?
