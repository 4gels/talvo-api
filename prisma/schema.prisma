  tracking_number       String?  @db.VarChar(50)
  currency              String   @default("EGP") @db.VarChar(3)
  exchange_rate         Float    @default(1)
  approved_by           Int?
  approved_at           DateTime?
  cancelled_by          Int?
  cancelled_at          DateTime?
  cancellation_reason   String?  @db.Text
  company_id            Int?
