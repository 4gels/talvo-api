  product_id          Int
  batch_id            Int?
  movement_type       String   @db.VarChar(30)
  tenant_id           Int
  reference_type      String?  @db.VarChar(30)
  reference_id        Int?
  reference_number    String?  @db.VarChar(50)
  quantity            Float
  unit_price          Float    @default(0)
  total_value         Float    @default(0)
  cost_price          Float    @default(0)
  profit_amount       Float    @default(0)
  profit_percent      Float    @default(0)
  batch_number        String?  @db.VarChar(50)
  expiry_date         DateTime?
  from_warehouse_id   Int?
  to_warehouse_id     Int?
  source_warehouse_id Int?
  dest_warehouse_id   Int?
  adjustment_reason   String?  @db.VarChar(200)
  old_quantity        Float    @default(0)
  new_quantity        Float    @default(0)
  status              String   @default("completed") @db.VarChar(20)
  approved_by         Int?
  approved_at         DateTime?
  cancelled_by        Int?
  cancelled_at        DateTime?
  cancellation_reason String?  @db.Text
  customer_id         Int?
  supplier_id         Int?
  company_id          Int?
  movement_date       DateTime @default(now())
  notes               String?  @db.Text
  user_id             Int?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  sync_id             String   @unique @default(cuid())
  is_deleted          Boolean  @default(false)
  sync_status         String   @default("pending")
  synced_at           DateTime?

  // ✅ العلاقات
  product         Product          @relation(fields: [product_id], references: [id])
  user            User?            @relation("UserInventoryMovements", fields: [user_id], references: [id])
  approver        User?            @relation("ApproverMovements", fields: [approved_by], references: [id])
  canceller       User?            @relation("CancellerMovements", fields: [cancelled_by], references: [id])
  tenant          Tenant           @relation(fields: [tenant_id], references: [id])
  from_warehouse  Warehouse?       @relation("FromWarehouse", fields: [from_warehouse_id], references: [id])
  to_warehouse    Warehouse?       @relation("ToWarehouse", fields: [to_warehouse_id], references: [id])
  customer        Customer?        @relation(fields: [customer_id], references: [id])
  supplier        Supplier?        @relation(fields: [supplier_id], references: [id])
  company         Company?         @relation(fields: [company_id], references: [id])
  @@map("inventory_movements")
}

// =============================================
// ✅ 7. جداول الطلبات والأنشطة والإعدادات
// =============================================

model PurchaseRequest {
  id                   Int      @id @default(autoincrement())
  request_number       String   @unique @db.VarChar(20)
  company_id           Int
  tenant_id            Int
  request_date         DateTime @default(now())
  notes                String?  @db.Text
  status               String   @default("pending") @db.VarChar(20)
  price_comparison_done Boolean @default(false)
  best_price           Float    @default(0)
  best_supplier_id     Int?
  user_id              Int?
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt
  sync_id              String   @unique @default(cuid())
  is_deleted           Boolean  @default(false)
  sync_status          String   @default("pending")
  synced_at            DateTime?
  best_supplier Supplier? @relation("BestSupplier", fields: [best_supplier_id], references: [id])
  // ✅ العلاقات
  company       Company     @relation(fields: [company_id], references: [id])
  tenant        Tenant      @relation(fields: [tenant_id], references: [id])
  user          User?       @relation(fields: [user_id], references: [id])
  items         PurchaseRequestItem[]
  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id                Int      @id @default(autoincrement())
  request_id        Int
  company_product_id Int
  tenant_id         Int
  quantity          Float    @default(1)
  suggested_price   Float    @default(0)
  competitor_prices Json?    // سيتم تخزينه كـ JSON
  best_price        Float    @default(0)
  best_supplier_id  Int?
  notes             String?  @db.Text
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  sync_id           String   @unique @default(cuid())
  is_deleted        Boolean  @default(false)
  sync_status       String   @default("pending")
  synced_at         DateTime?
  best_supplier Supplier? @relation("BestSupplierItem", fields: [best_supplier_id], references: [id])
  // ✅ العلاقات
  request       PurchaseRequest @relation(fields: [request_id], references: [id])
  company_product CompanyProduct @relation(fields: [company_product_id], references: [id])
  tenant        Tenant          @relation(fields: [tenant_id], references: [id])
  @@map("purchase_request_items")
}

model TransactionType {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  arabic_name String   @db.VarChar(50)
  icon        String   @default("📌") @db.VarChar(20)
  color       String   @default("secondary") @db.VarChar(20)
  is_active   Boolean  @default(true)
  is_collection Boolean @default(false)
  is_refund   Boolean  @default(false)
  priority    Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  tenant_id   Int
  sync_id     String   @unique @default(cuid())
  is_deleted  Boolean  @default(false)
  sync_status String   @default("pending")
  synced_at   DateTime?

  // ✅ العلاقات
  tenant Tenant @relation(fields: [tenant_id], references: [id])
  @@map("transaction_types")
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  user_id     Int?
  action      String   @db.VarChar(100)
  module      String   @db.VarChar(50)
  description String?  @db.Text
  ip_address  String?  @db.VarChar(45)
  user_agent  String?  @db.VarChar(200)
  created_at  DateTime @default(now())
  tenant_id   Int?
  sync_id     String   @unique @default(cuid())
  is_deleted  Boolean  @default(false)
  sync_status String   @default("pending")
  synced_at   DateTime?

  // ✅ العلاقات
  user   User?   @relation(fields: [user_id], references: [id])
  tenant Tenant? @relation(fields: [tenant_id], references: [id])
  @@map("activity_logs")
}

model Setting {
  id            Int       @id @default(autoincrement())
  key           String    @db.VarChar(100)
  value         String?   @db.Text
  group_name    String    @default("general") @db.VarChar(50)
  is_public     Boolean   @default(false)
  is_encrypted  Boolean   @default(false)
  description   String?   @db.VarChar(200)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  tenant_id     Int?
  sync_id       String    @unique @default(cuid())
  is_deleted    Boolean   @default(false)
  sync_status   String    @default("pending")
  synced_at     DateTime?

  tenant        Tenant?   @relation(fields: [tenant_id], references: [id])

  @@unique([key, tenant_id], name: "uq_settings_key_tenant")
  @@index([tenant_id])
  @@index([group_name])

  @@map("settings")
}

model CustomerTransaction {
  id                Int      @id @default(autoincrement())
  customer_id       Int
  tenant_id         Int
  transaction_type  String   @db.VarChar(20)
  amount            Float
  balance_before    Float
  balance_after     Float
  reference_type    String?  @db.VarChar(20)
  reference_id      Int?
  description       String?  @db.VarChar(200)
  transaction_date  DateTime @default(now())
  user_id           Int?
  sync_id           String   @unique @default(cuid())
  is_deleted        Boolean  @default(false)
  sync_status       String   @default("pending")
  synced_at         DateTime?

  // ✅ العلاقات
  customer Customer @relation(fields: [customer_id], references: [id])
  tenant   Tenant   @relation(fields: [tenant_id], references: [id])
  user     User?    @relation(fields: [user_id], references: [id])
  @@map("customer_transactions")
}

model CustomerDiscountPolicy {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(50)
  description   String?  @db.Text
  min_purchases Float    @default(0)
  min_quantity  Int      @default(0)
  customer_tier String?  @db.VarChar(20)
  tenant_id     Int
  discount_type String   @default("percentage") @db.VarChar(10)
  discount_value Float   @default(0)
  apply_to_all  Boolean  @default(true)
  category_ids  String?  @db.Text
  product_ids   String?  @db.Text
  start_date    DateTime?
  end_date      DateTime?
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  company_id    Int?
  sync_id       String   @unique @default(cuid())
  is_deleted    Boolean  @default(false)
  sync_status   String   @default("pending")
  synced_at     DateTime?

  // ✅ العلاقات
  tenant  Tenant    @relation(fields: [tenant_id], references: [id])
  company Company?  @relation(fields: [company_id], references: [id])
  customers Customer[]
  @@map("customer_discount_policies")
}

model TreasuryTransaction {
  id                    Int      @id @default(autoincrement())
  tenant_id             Int
  party_type            String   @db.VarChar(20)
  party_id              Int?
  transaction_type      String   @db.VarChar(30)
  amount                Float
  treasury_balance_before Float @default(0)
  treasury_balance_after Float @default(0)
  party_balance_before  Float    @default(0)
  party_balance_after   Float    @default(0)
  reference_type        String?  @db.VarChar(30)
  reference_id          Int?
  description           String?  @db.Text
  transaction_date      DateTime @default(now())
  user_id               Int?
  sync_id               String   @unique @default(cuid())
  is_deleted            Boolean  @default(false)
  sync_status           String   @default("pending")
  synced_at             DateTime?
  employee Employee? @relation("EmployeeTreasury", fields: [party_id], references: [id], map: "TreasuryTransaction_party_id_employee_fkey")


  // ✅ العلاقات (مع أسماء فريدة للمفاتيح الأجنبية)
  tenant          Tenant        @relation(fields: [tenant_id], references: [id])
  user            User?         @relation(fields: [user_id], references: [id])
  customer        Customer?     @relation(fields: [party_id], references: [id], map: "TreasuryTransaction_party_id_customer_fkey")
  supplier        Supplier?     @relation(fields: [party_id], references: [id], map: "TreasuryTransaction_party_id_supplier_fkey")
  sale_invoice    SaleInvoice?  @relation(fields: [reference_id], references: [id], map: "TreasuryTransaction_reference_id_sale_invoice_fkey")
  purchase_invoice PurchaseInvoice? @relation(fields: [reference_id], references: [id], map: "TreasuryTransaction_reference_id_purchase_invoice_fkey")
  sales_return    SalesReturn?  @relation(fields: [reference_id], references: [id], map: "TreasuryTransaction_reference_id_sales_return_fkey")
  purchase_return PurchaseReturn? @relation(fields: [reference_id], references: [id], map: "TreasuryTransaction_reference_id_purchase_return_fkey")
  @@map("treasury_transactions")

}

// =============================================
// ✅ 8. جداول المزامنة (بدون علاقات مباشرة مع Tenant)
// =============================================

model SyncQueue {
  id          Int      @id @default(autoincrement())
  product_id  Int
  local_path  String   @db.VarChar(500)
  public_id   String?  @db.VarChar(200)
  status      String   @default("pending") @db.VarChar(20)
  retry_count Int      @default(0)
  error_message String? @db.Text
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  sync_id     String   @unique @default(cuid())
  is_deleted  Boolean  @default(false)
  sync_status String   @default("pending")
  synced_at   DateTime?

  // ✅ العلاقات
  product Product @relation(fields: [product_id], references: [id])
  @@map("sync_queue")
}

model DataSyncQueue {
  id            Int      @id @default(autoincrement())
  table_name    String   @db.VarChar(100)
  sync_id       String   @db.VarChar(36)
  operation     String   @db.VarChar(20)
  data_snapshot Json?
  source        String   @default("local") @db.VarChar(20)
  status        String   @default("pending") @db.VarChar(20)
  retry_count   Int      @default(0)
  error_message String?  @db.Text
  created_at    DateTime @default(now())
  synced_at     DateTime?
  updated_at    DateTime @updatedAt
  sync_id_field String   @unique @default(cuid())
  is_deleted    Boolean  @default(false)
  sync_status   String   @default("pending")
  synced_at_field DateTime?
  @@map("data_sync_queue")
}

model SyncConflict {
  id          Int      @id @default(autoincrement())
  sync_id     String   @db.VarChar(36)
  table_name  String   @db.VarChar(100)
  local_value Json?
  cloud_value Json?
  status      String   @default("pending") @db.VarChar(20)
  resolution  String?  @db.VarChar(20)
  notes       String?  @db.Text
  resolved_by Int?
  resolved_at DateTime?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  sync_id_field String @unique @default(cuid())
  is_deleted  Boolean  @default(false)
  sync_status String   @default("pending")
  synced_at   DateTime?

  resolver User? @relation("ResolvedConflicts", fields: [resolved_by], references: [id])
  // ✅ العلاقات
  @@map("sync_conflicts")
}