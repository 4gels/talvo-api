  receiver           User?             @relation("PurchaseInvoiceReceiver", fields: [received_by], references: [id])  // ✅ جديد
  tenant             Tenant            @relation(fields: [tenant_id], references: [id])
  company            Company?          @relation(fields: [company_id], references: [id])
  responsible_employee Employee?       @relation(fields: [responsible_employee_id], references: [id])
  original_invoice   PurchaseInvoice?  @relation("OriginalInvoice", fields: [original_invoice_id], references: [id])
  child_invoices     PurchaseInvoice[] @relation("OriginalInvoice")

  returns            PurchaseReturn[]  
  items              PurchaseInvoiceItem[]
  batches            ProductBatch[]
  treasury_transactions TreasuryTransaction[]
  
  @@map("purchase_invoices")
}

